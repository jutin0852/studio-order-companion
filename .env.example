# Copy to .env.local and fill in. Never commit real values.
DATABASE_URL=
BETTER_AUTH_SECRET=        # long random string (32+ chars)
BETTER_AUTH_URL=http://localhost:3010
NEXT_PUBLIC_APP_URL=http://localhost:3010
GOOGLE_CLIENT_ID=            # optional
GOOGLE_CLIENT_SECRET=        # optional
RESEND_API_KEY=              # optional (password recovery email)
RESEND_FROM_EMAIL=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=   # npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
CRON_SECRET=                 # long random string
NOTIFICATIONS_APP_URL=       # optional, deployed URL for the reminder processor
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Notifications are paused unless this is exactly "false". See docs/notifications-pause.md.
STUDIO_NOTIFICATIONS_PAUSED=true
