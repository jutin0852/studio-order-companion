{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studio-notification-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-09",
  "workers_dev": false,
  "vars": {
    "NOTIFICATIONS_PAUSED": "true"
  },
  "kv_namespaces": [
    { "binding": "SCHEDULE", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}
