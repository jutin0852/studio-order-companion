{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studio-notification-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "vars": {
    "NOTIFICATIONS_PAUSED": "true"
  },
  "durable_objects": {
    "bindings": [{ "name": "SCHEDULER", "class_name": "NotificationScheduler" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NotificationScheduler"] }],
  "triggers": {
    "crons": ["*/30 * * * *"]
  }
}
